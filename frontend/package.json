{
  "name": "gps-tracker-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ingest": "node scripts/ingest_downloads.mjs",
    "sync:cf": "node scripts/sync_cloudflare.mjs",
    "deploy:cf": "npm run build && npx wrangler deploy",
    "gpsl0:selftest": "node scripts/selftest_gpsl0.mjs",
    "gpsl0:bench": "node scripts/bench_gpsl0.mjs --verify --stats",
    "gpsl0:ablate": "node scripts/ablation_codec.mjs --matrix=core",
    "gpsl0:verify": "node scripts/verify_gpsl0.mjs --all",
    "gpsl0:pack": "node scripts/pack_gpsl0.mjs --verify"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gpx_viewer": "^1.1.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "vite-plugin-pwa": "^1.0.2",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
