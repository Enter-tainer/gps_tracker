{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gps-fog-tracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-27",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "TRACKS_BUCKET",
      "bucket_name": "gps-tracks"
    }
  ],
  "d1_databases": [
    {
      "binding": "TRACKS_DB",
      "database_name": "gps_tracks",
      "database_id": "b10f31d8-a88d-4d68-be64-9580b6bba452",
      "migrations_dir": "migrations"
    }
  ]
  // Optional Cloudflare Access for SaaS (OIDC) configuration for /api/agent/*:
  // Set via `wrangler secret put` or Dashboard -> Workers -> Variables & Secrets:
  //   OIDC_ISSUER         = "https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<client-id>"
  //   OIDC_CLIENT_ID      = "<client-id>"
  //   OIDC_AUD            = "<client-id>" (optional, defaults to OIDC_CLIENT_ID)
  //   OIDC_SCOPES         = "openid email profile" (optional)
  //   OIDC_ALLOWED_EMAILS = "you@example.com" (optional comma-separated allowlist)
}
